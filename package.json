{
  "name": "taicc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pipeline": "tsx --tsconfig tsconfig.scripts.json scripts/run-pipeline.ts",
    "trace": "tsx --tsconfig tsconfig.scripts.json scripts/trace.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig tsconfig.scripts.json scripts/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pipeline:seed": "tsx --tsconfig tsconfig.scripts.json scripts/run-pipeline.ts seed",
    "snapshot:create": "tsx --tsconfig tsconfig.scripts.json scripts/create-snapshot.ts",
    "quality": "tsx --tsconfig tsconfig.scripts.json scripts/quality-report.ts",
    "audit:relevance": "tsx --tsconfig tsconfig.scripts.json scripts/audit-report.ts relevance",
    "audit:voice": "tsx --tsconfig tsconfig.scripts.json scripts/audit-report.ts voice",
    "audit:dedup": "tsx --tsconfig tsconfig.scripts.json scripts/audit-report.ts dedup",
    "backfill": "tsx --tsconfig tsconfig.scripts.json scripts/backfill.ts",
    "scheduler": "tsx --tsconfig tsconfig.scripts.json scripts/scheduler.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "ai": "^7.0.77",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.0",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
